# Copy this file to .streamlit/secrets.toml (git-ignored) and fill in the
# values from https://www.strava.com/settings/api
[strava]
client_id = "12345"
client_secret = "your-client-secret"
# Must be on the "Authorization Callback Domain" of your Strava API app
# (set that domain to: localhost). Change the port if you run Streamlit elsewhere.
redirect_uri = "http://localhost:8501/"
