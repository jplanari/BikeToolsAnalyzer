# Copy this file to .streamlit/secrets.toml (git-ignored) and fill in the
# values from https://www.strava.com/settings/api
[strava]
client_id = "12345"
client_secret = "your-client-secret"
# Must be on the "Authorization Callback Domain" of your Strava API app
# (set that domain to: localhost). Change the port if you run Streamlit elsewhere.
redirect_uri = "http://localhost:8501/"

# Wahoo Cloud API: register an app at https://developers.wahooligan.com and add the
# redirect URI below as a callback URL. Gives you the original FIT files.
[wahoo]
client_id = "your-wahoo-client-id"
client_secret = "your-wahoo-client-secret"
# Wahoo requires an https callback: use the forwarding page of this repo (publish /docs with GitHub Pages,
# see README.md and desktop/README.md) and add the same address as callback URL in the Wahoo developer portal.
# Replace the user and repository name if you fork it.
redirect_uri = "https://jplanari.github.io/BikeToolsAnalyzer/oauth/"
# Time zone used to schedule planned sessions (default: this computer's)
# timezone = "Europe/Madrid"

# Polar AccessLink: register a client at https://admin.polaraccesslink.com and add the redirect URI below to it.
# Polar only shares the last 30 days of rides (recorded after connecting), so sync at least monthly.
[polar]
client_id = "your-polar-client-id"
client_secret = "your-polar-client-secret"
redirect_uri = "http://localhost:8501/"
