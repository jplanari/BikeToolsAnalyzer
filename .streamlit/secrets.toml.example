# Copy this file to .streamlit/secrets.toml (git-ignored) and fill in the
# values from https://www.strava.com/settings/api
[strava]
client_id = "12345"
client_secret = "your-client-secret"
# Must be on the "Authorization Callback Domain" of your Strava API app
# (set that domain to: localhost). Change the port if you run Streamlit elsewhere.
redirect_uri = "http://localhost:8501/"

# Wahoo Cloud API: register an app at https://developers.wahooligan.com and add the
# redirect URI below as a callback URL. Gives you the original FIT files.
[wahoo]
client_id = "your-wahoo-client-id"
client_secret = "your-wahoo-client-secret"
redirect_uri = "http://localhost:8501/"
# Time zone used to schedule planned sessions (default: this computer's)
# timezone = "Europe/Madrid"
