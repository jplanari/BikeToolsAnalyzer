# Caddy gets and renews the HTTPS certificate for $DOMAIN by itself (the domain must point at this server, ports 80 and
# 443 open). It passes WebSocket traffic, which Streamlit needs, and sends the visitor's address in X-Forwarded-For.
{$DOMAIN} {
	encode gzip
	request_body {
		max_size 250MB
	}
	reverse_proxy app:8501
}
