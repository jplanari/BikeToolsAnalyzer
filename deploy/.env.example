# Copy to deploy/.env and fill in. Keep this file private (it holds secrets) and out of version control.

# The address riders will use, without https://. Its DNS record must point at this server.
DOMAIN=bike.example.net

# Database password. Letters and digits only (it goes into a connection address). Make one:  openssl rand -hex 24
POSTGRES_PASSWORD=

# Encrypts the stored Strava/Wahoo/Polar tokens. Make one:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Store a copy somewhere safe and SEPARATE from the database backups: without it a restored database loses every connection.
BIKETOOLS_SECRET_KEY=

# The mail account that sends the confirmation and password-reset e-mails (host and sender are required for sign-up to work).
BIKETOOLS_SMTP_HOST=
BIKETOOLS_SMTP_PORT=587
BIKETOOLS_SMTP_SECURITY=starttls
BIKETOOLS_SMTP_USER=
BIKETOOLS_SMTP_PASSWORD=
BIKETOOLS_SMTP_SENDER=

# Limits (MB). Defaults shown; 0 turns one off.
BIKETOOLS_RIDER_QUOTA_MB=500
BIKETOOLS_MAX_ACTIVITY_MB=50
BIKETOOLS_MAX_UNPACKED_MB=500
